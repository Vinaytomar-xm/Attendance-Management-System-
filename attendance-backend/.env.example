# Rename this file to .env and fill in real values. Never commit the real .env file.

PORT=5000
NODE_ENV=development

# MongoDB connection string (MongoDB Atlas or local)
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/attendance-db

# JWT secret - use a long, random string in production
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Cookie settings
COOKIE_EXPIRES_DAYS=7

# Frontend origin allowed to make credentialed requests (CORS)
CLIENT_URL=http://localhost:5173
